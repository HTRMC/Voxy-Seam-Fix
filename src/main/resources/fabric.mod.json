{
  "schemaVersion": 1,
  "id": "voxy-seam-fix",
  "version": "${version}",
  "name": "Voxy Seam Fix",
  "description": "Pins voxy's lod fluid surfaces to one height so the sea does not step at every lod ring.",
  "authors": [
    "HTRMC"
  ],
  "license": "MIT",
  "icon": "assets/voxy-seam-fix/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.htrmc.voxyseamfix.VoxySeamFix"
    ]
  },
  "mixins": [
    {
      "config": "voxyseamfix.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "minecraft": ">=26.2",
    "fabricloader": ">=0.14.22",
    "voxy": "*"
  }
}
